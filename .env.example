# ============================== AI (obbligatoria per la qualità piena)
# Chiave Gemini: genera i post, li valuta e aggiorna il playbook.
# Senza chiave il sistema funziona in modalità fallback (template + approvazione manuale).
GEMINI_API_KEY=""
# Modello opzionale (default: gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# ============================== Motore
# Mettere a "false" per avviare il server con il motore in pausa.
# ENGINE_AUTOSTART="true"

# ============================== Credenziali social (tutte opzionali)
# Ogni piattaforma senza credenziali complete lavora in MODALITÀ SIMULAZIONE:
# il flusso resta attivo e i post "simulati" sono visibili in dashboard.

# Telegram: crea un bot con @BotFather e usa l'ID del canale/gruppo di destinazione.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Mastodon: dal tuo profilo -> Sviluppo -> Nuova applicazione (scope write:statuses).
MASTODON_BASE_URL="https://mastodon.social"
MASTODON_ACCESS_TOKEN=""

# X / Twitter: app su developer.x.com con permessi Read+Write (OAuth 1.0a user context).
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

# Facebook: Page ID + Page Access Token (Graph API, permesso pages_manage_posts).
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_TOKEN=""

# Instagram: account Business collegato a una pagina Facebook (Instagram Graph API).
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# LinkedIn: token con scope w_member_social e URN dell'autore (es. urn:li:person:xxxx).
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""
